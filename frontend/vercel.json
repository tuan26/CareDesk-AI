{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/book/:path*", "destination": "https://REPLACE-WITH-BACKEND-HOST/book/:path*" },
    { "source": "/sitemap.xml", "destination": "https://REPLACE-WITH-BACKEND-HOST/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://REPLACE-WITH-BACKEND-HOST/robots.txt" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
