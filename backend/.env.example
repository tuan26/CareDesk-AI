# === CareDesk AI - Backend configuration ===
# Copy to .env and fill in real values. All keys are optional in dev (mock mode).

# development | production. Gates demo-data seeding + startup safety checks
# (default SECRET_KEY and wildcard CORS both hard-fail startup in production).
ENVIRONMENT=development

# BẮT BUỘC khi chạy production
SECRET_KEY=change-me-to-a-long-random-string

# Database: mặc định SQLite (dev). Production dùng PostgreSQL + alembic upgrade head
# DATABASE_URL=postgresql://user:password@localhost:5432/caredesk
DATABASE_URL=sqlite:///./caredesk.db

# SQLAlchemy connection pool. Mặc định thư viện (5 + 10 overflow = 15 kết nối)
# quá nhỏ - load test 100 request đồng thời đã làm nghẽn hết pool, request
# phải chờ tới 30s rồi timeout. Tăng theo tải thực tế của bạn.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy. Production
# KHÔNG được để "*" (app sẽ từ chối khởi động).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed tài khoản/dữ liệu demo (admin/owner/receptionist, phòng khám mẫu, chuỗi
# demo...). Mặc định: bật ở dev, TẮT ở production. Đặt "true"/"false" để ép buộc.
# SEED_DEMO_DATA=false

# Tài khoản platform super-admin (bắt buộc phải có ít nhất 1 tài khoản để vào
# /platform). Để trống ở production sẽ tự sinh mật khẩu ngẫu nhiên và log ra
# console MỘT LẦN DUY NHẤT khi khởi động lần đầu — nên set trước khi deploy.
# PLATFORM_ADMIN_EMAIL=platform@yourdomain.com
# PLATFORM_ADMIN_PASSWORD=

# Số worker uvicorn (nếu >1): scheduler nhắc lịch và rate limiter đang chạy
# in-memory/single-process, chạy nhiều worker sẽ nhân bản reminder + rate
# limit theo số worker. Chỉ set >1 khi đã tắt ENABLE_REMINDER_SCHEDULER trên
# các worker phụ, hoặc chuyển rate limit sang Redis.
# WEB_CONCURRENCY=1

# AI (bỏ trống = chạy mock engine, vẫn demo được đầy đủ)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-5.6-terra

# Email nhắc lịch (bỏ trống = log ra console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@caredesk.ai
EMAILS_FROM_NAME=CareDesk AI Receptionist

# SMS gateway (bỏ trống = mock; ZNS cấu hình per-clinic trong dashboard)
SMS_API_KEY=

# URL công khai của backend (dùng trong link xác nhận/hủy lịch gửi cho khách)
PUBLIC_BASE_URL=http://localhost:8000

# Bộ nhắc lịch tự động (24h/2h trước giờ hẹn)
ENABLE_REMINDER_SCHEDULER=true

# Rate limit endpoint công khai (request/phút/IP)
RATE_LIMIT_PER_MINUTE=30
