# === docker-compose configuration ===
# Copy to .env at the repo root (docker-compose reads it automatically) and
# fill in real values before running `docker compose up`.
# Backend-only dev (no Docker) uses backend/.env.example instead.

POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated, no wildcard allowed (ENVIRONMENT=production enforces this).
BACKEND_CORS_ORIGINS=https://app.yourdomain.com

# Public URL patients/browsers hit - used to build confirm/cancel links and
# as the frontend's build-time API base.
PUBLIC_BASE_URL=http://localhost:8000

# Leave false in production - seeds demo accounts/clinic otherwise.
SEED_DEMO_DATA=false

# Bootstrap platform super-admin. Leave blank to auto-generate a random
# password on first boot (check `docker compose logs backend` once for it).
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

OPENAI_API_KEY=

# === Kênh gửi tin nhắn cho bệnh nhân ===
# Nhắc lịch là một nửa lời hứa "giảm no-show". Để trống toàn bộ phần này thì
# tin nhắn KHÔNG được gửi — hệ thống báo rõ điều đó trên Dashboard và giữ lại
# các lịch chưa nhắc để gửi bù, chứ không giả vờ đã gửi.
#
#   dev      SMS_PROVIDER=mock                     (không cần tài khoản)
#   staging  SMS_PROVIDER=esms + SMS_SANDBOX=true  (gọi API thật, không tính phí,
#                                                   không tới máy khách)
#   prod     SMS_PROVIDER=esms + SMS_SANDBOX=false
#
# App sẽ TỪ CHỐI khởi động nếu ENVIRONMENT=production mà còn mock/sandbox.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=
SMS_SANDBOX=false

# Thời gian giữ chỗ trong lúc khách đặt cọc (phút).
DEPOSIT_HOLD_MINUTES=15

# Nơi phục vụ ứng dụng React. Production dùng chung domain với PUBLIC_BASE_URL
# (Vercel phục vụ SPA và rewrite /book/* về backend) nên để trống là đúng.
# Ở dev thì hai cổng khác nhau: landing ở :8000, Vite ở :5173 — không đặt biến
# này thì link "Đặt lịch với trợ lý ảo" trên landing sẽ 404.
FRONTEND_BASE_URL=
